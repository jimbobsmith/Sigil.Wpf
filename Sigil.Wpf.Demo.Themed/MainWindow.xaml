<mah:MetroWindow x:Class="Sigil.Wpf.Demo.Themed.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:sigil="clr-namespace:Sigil.Wpf.AutoBinder;assembly=Sigil.Wpf"
                 Title="Sigil — Material Design + MahApps"
                 TitleCharacterCasing="Normal"
                 Width="1080"
                 Height="920"
                 MinWidth="920"
                 MinHeight="740"
                 GlowBrush="{DynamicResource PrimaryHueMidBrush}"
                 WindowStartupLocation="CenterScreen"
                 TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                 TextElement.FontWeight="Regular"
                 TextElement.FontSize="14"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="Auto"
                 Background="{DynamicResource MaterialDesignPaper}"
                 FontFamily="{materialDesign:MaterialDesignFont}"
                 sigil:AutoBind.Enabled="True">
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button Content="Toggle theme" Click="ToggleTheme_OnClick" />
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top"
                                  Mode="PrimaryMid"
                                  Padding="20,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Puzzle" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Same rules. Their controls."
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Margin="38,6,0,0" Opacity="0.9" TextWrapping="Wrap"
                           Text="Material Design styles the chrome. MahApps brings MetroWindow, NumericUpDown, and ToggleSwitch. AutoBind still only needs the value binding." />
            </StackPanel>
        </materialDesign:ColorZone>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="Form" />
                        <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap"
                                   Text="Outlined TextBox and ComboBox are Material. Amount is a MahApps NumericUpDown plus a themed Slider — both bound to Amount, both get the same rules." />

                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Name (Material TextBox)"
                                 Margin="0,0,0,8" />
                        <CheckBox Content="Rush order — FontSize + FontWeight"
                                  IsChecked="{Binding IsRush}"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Margin="0,0,0,16" />

                        <materialDesign:Card UniformCornerRadius="4"
                                             Padding="10"
                                             Background="#FFF8E1"
                                             Visibility="{Binding [Visibility.Amount]}"
                                             Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Alert" Width="20" Height="20" Foreground="#8A6D00" Margin="0,0,8,0" />
                                <TextBlock Text="Approval required — amount is over $1,000"
                                           Foreground="#8A6D00"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </materialDesign:Card>

                        <mah:NumericUpDown Value="{Binding Amount}"
                                           Minimum="0"
                                           Maximum="20000"
                                           Interval="50"
                                           HideUpDownButtons="False"
                                           materialDesign:HintAssist.Hint="Amount (MahApps NumericUpDown)" />
                        <Slider Value="{Binding Amount}"
                                Minimum="0"
                                Maximum="2000"
                                TickFrequency="250"
                                IsSnapToTickEnabled="False"
                                Margin="0,8,0,16"
                                ToolTip="Amount (themed Slider)" />

                        <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Margin="0,0,0,6"
                                   Text="Status (Material ComboBox, chrome on the wrapper)" />
                        <Border Padding="4" Margin="0,0,0,16" BorderThickness="2">
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding Status}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Status" />
                        </Border>

                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Notes (Material TextBox)"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="88"
                                 Margin="0,0,0,16" />

                        <TextBox Text="{Binding ReferenceCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Reference (exempt, Material TextBox)"
                                 Margin="0,0,0,16" />
                    </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="Line items" />
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"
                                   Text="Line amount limit and highlight apply to the Amount column. Removing a row disposes it (unhooks the parent). Closing the window disposes the rest." />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Left"
                                     Text="{Binding LineLimit, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Line amount limit"
                                     Width="150"
                                     Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox Content="Highlight Amount over the limit"
                                          IsChecked="{Binding HighlightOverLimit}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          Margin="0,0,0,4" />
                                <CheckBox Content="Freeze Posted rows"
                                          IsChecked="{Binding FreezePostedLines}"
                                          Style="{StaticResource MaterialDesignCheckBox}" />
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="Add line" Style="{StaticResource MaterialDesignOutlinedButton}" Click="AddLine_OnClick" Margin="0,0,8,8" />
                            <Button Content="Remove selected" Style="{StaticResource MaterialDesignOutlinedButton}" Click="RemoveSelectedLine_OnClick" Margin="0,0,8,8" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Lines}"
                                  SelectedItem="{Binding SelectedLine}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  VerticalAlignment="Stretch">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="IsEnabled" Value="{Binding IsRowEnabled}" />
                                    <Setter Property="Opacity" Value="{Binding RowOpacity}" />
                                    <Setter Property="ToolTip" Value="{Binding RowToolTip}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Item" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     Padding="4,2"
                                                     sigil:AutoBind.Enabled="True" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Amount" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     Padding="4,2"
                                                     sigil:AutoBind.Enabled="True" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                                      SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      BorderThickness="0"
                                                      sigil:AutoBind.Enabled="True" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="Rule levels" />
                        <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap"
                                   Text="MahApps ToggleSwitch for temporary/global. Material buttons for property rules. Toggle theme in the title bar — Sigil chrome still wins on Amount." />

                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Text="1. Temporary" FontWeight="SemiBold" />
                        <mah:ToggleSwitch Content="Hold for review"
                                          IsOn="{Binding IsOnHold}"
                                          Margin="0,4,0,12" />

                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Text="2. All properties" FontWeight="SemiBold" />
                        <mah:ToggleSwitch Content="Lock form"
                                          IsOn="{Binding IsLocked}"
                                          Margin="0,4,0,12" />

                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Text="3. Property" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="$250" Style="{StaticResource MaterialDesignOutlinedButton}" Click="SetAmount250_OnClick" Margin="0,0,8,8" />
                            <Button Content="$750" Style="{StaticResource MaterialDesignOutlinedButton}" Click="SetAmount750_OnClick" Margin="0,0,8,8" />
                            <Button Content="$1,500" Style="{StaticResource MaterialDesignRaisedButton}" Click="SetAmount1500_OnClick" Margin="0,0,8,8" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Clear name" Style="{StaticResource MaterialDesignFlatButton}" Click="ClearName_OnClick" Margin="0,0,8,8" />
                            <Button Content="Restore name" Style="{StaticResource MaterialDesignFlatButton}" Click="RestoreName_OnClick" Margin="0,0,8,8" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="Stamp URGENT" Style="{StaticResource MaterialDesignFlatButton}" Click="StampUrgent_OnClick" Margin="0,0,8,8" />
                            <Button Content="Reset notes" Style="{StaticResource MaterialDesignFlatButton}" Click="ResetNotes_OnClick" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Text="Winning level" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding NameChrome}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Amount" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AmountChrome}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding StatusChrome}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Notes" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding NotesChrome}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Reference" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ReferenceWinner}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
