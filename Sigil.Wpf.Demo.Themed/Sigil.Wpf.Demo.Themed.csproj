<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Sigil.Wpf.Demo.Themed</RootNamespace>
    <AssemblyName>Sigil.Wpf.Demo.Themed</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sigil.Wpf.csproj" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="5.3.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Sigil.Wpf.Demo\DemoViewModel.cs" Link="DemoViewModel.cs" />
  </ItemGroup>
</Project>
