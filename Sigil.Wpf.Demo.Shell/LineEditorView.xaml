<mah:MetroWindow x:Class="Sigil.Wpf.Demo.Shell.LineEditorView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:cal="http://www.caliburnproject.org"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:sigil="clr-namespace:Sigil.Wpf.AutoBinder;assembly=Sigil.Wpf"
                 Title="{Binding DisplayName}"
                 TitleCharacterCasing="Normal"
                 Width="440"
                 SizeToContent="Height"
                 ShowInTaskbar="False"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 GlowBrush="{DynamicResource PrimaryHueMidBrush}"
                 Background="{DynamicResource MaterialDesignPaper}"
                 FontFamily="{materialDesign:MaterialDesignFont}"
                 sigil:AutoBind.Enabled="True">
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   Text="Own engine. The tab's line limit still highlights Amount; the tab's lock does not disable this dialog." />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Item"
                 Margin="0,0,0,12" />
        <mah:NumericUpDown Value="{Binding Amount}"
                           Minimum="0"
                           Maximum="20000"
                           Interval="10"
                           materialDesign:HintAssist.Hint="Amount"
                           Margin="0,0,0,12" />
        <ComboBox ItemsSource="{Binding StatusOptions}"
                  SelectedItem="{Binding Status}"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                  materialDesign:HintAssist.Hint="Status"
                  Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}" cal:Message.Attach="Cancel" Margin="0,0,8,0" />
            <Button Content="Save" Style="{StaticResource MaterialDesignRaisedButton}" cal:Message.Attach="Save" />
        </StackPanel>
    </StackPanel>
</mah:MetroWindow>
