<mah:MetroWindow x:Class="Sigil.Wpf.Demo.Shell.NewInvoiceView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:cal="http://www.caliburnproject.org"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:sigil="clr-namespace:Sigil.Wpf.AutoBinder;assembly=Sigil.Wpf"
                 Title="{Binding DisplayName}"
                 TitleCharacterCasing="Normal"
                 Width="440"
                 SizeToContent="Height"
                 ShowInTaskbar="False"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 GlowBrush="{DynamicResource PrimaryHueMidBrush}"
                 Background="{DynamicResource MaterialDesignPaper}"
                 FontFamily="{materialDesign:MaterialDesignFont}"
                 sigil:AutoBind.Enabled="True">
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   Text="This dialog has its own engine and is disposed on close. Locking an invoice tab does not disable these fields." />
        <TextBox Text="{Binding Number}"
                 IsReadOnly="True"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Number"
                 Margin="0,0,0,12" />
        <TextBox Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Customer"
                 Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}" cal:Message.Attach="Cancel" Margin="0,0,8,0" />
            <Button Content="Create" Style="{StaticResource MaterialDesignRaisedButton}" cal:Message.Attach="Save" />
        </StackPanel>
    </StackPanel>
</mah:MetroWindow>
