<UserControl x:Class="Sigil.Wpf.Demo.Shell.InvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <materialDesign:Card Padding="16" Margin="4">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                       Text="Invoices" />
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Margin="0,4,0,12"
                       TextWrapping="Wrap"
                       Text="This tab is a Caliburn Screen with no engine. Open an invoice to create a workspace tab that owns one. New invoice opens a dialog that owns another." />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Content="New invoice"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        cal:Message.Attach="NewInvoice"
                        Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right"
                        Content="Open"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        cal:Message.Attach="OpenInvoice"
                        Margin="8,0,0,0" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Filter by number or customer" />
            </DockPanel>
            <DataGrid ItemsSource="{Binding FilteredInvoices}"
                      SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="120" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="90" />
                    <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </materialDesign:Card>
</UserControl>
