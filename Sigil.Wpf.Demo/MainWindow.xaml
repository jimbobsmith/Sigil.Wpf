<Window x:Class="Sigil.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sigil="clr-namespace:Sigil.Wpf.AutoBinder;assembly=Sigil.Wpf"
        Title="Sigil — any dependency property"
        Width="1000"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        Background="#F4F4F5"
        sigil:AutoBind.Enabled="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.15*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Form" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="XAML only binds the value. AutoBind attaches every DP the engine registered — IsEnabled, chrome, font, Opacity, IsReadOnly. Visibility stays explicit because it usually lives on a different element." />

                <TextBlock Style="{StaticResource Label}" Text="Name  —  empty: pink + disabled.  Rush: 18pt bold" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Rush order  —  FontSize + FontWeight on Name"
                          IsChecked="{Binding IsRush}"
                          Margin="0,0,0,12" />

                <TextBlock Style="{StaticResource Label}" Text="Amount  —  &gt; $500 yellow/gold, &gt; $1,000 bold red + banner" />
                <Border Margin="0,0,0,8"
                        Padding="8,6"
                        Background="#FFF8E1"
                        BorderBrush="#FFB300"
                        BorderThickness="1"
                        Visibility="{Binding [Visibility.Amount]}">
                    <TextBlock Text="Approval required — amount is over $1,000"
                               FontWeight="SemiBold"
                               Foreground="#8A6D00"
                               TextWrapping="Wrap" />
                </Border>
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource Label}" Text="Status  —  Review gold, Approved green, Rejected pink" />
                <Border Padding="3" Margin="0,0,0,10" BorderThickness="2">
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding Status}"
                              BorderThickness="0"
                              Background="Transparent"
                              Margin="0" />
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="Notes  —  short: italic gray.  URGENT: crimson.  Approved: read-only" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         Height="72"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Style="{StaticResource Label}" Text="Reference  —  [StateChangeExempt], including Opacity" />
                <TextBox Text="{Binding ReferenceCode, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Rule levels" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Priority: Temporary, then Global, then Property, then Default. Form fields are Text/SelectedItem only — the engine owns the rest. Exempt fields skip every rule; watch Reference stay crisp when the form fades." />

                <GroupBox Header="1. TemporaryRule  (highest)">
                    <StackPanel>
                        <CheckBox Content="Hold for review  —  disable + fade every non-exempt field"
                                  IsChecked="{Binding IsOnHold}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                                   Text="Injected and removed at runtime. Wins over lock and property rules." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. GlobalRule">
                    <StackPanel>
                        <CheckBox Content="Lock form  —  IsEnabled + Opacity on every non-exempt field"
                                  IsChecked="{Binding IsLocked}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                                   Text="Reference stays full opacity because [StateChangeExempt] skips the fade." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3. PropertyRule  (local)">
                    <StackPanel>
                        <TextBlock Text="Amount chrome + banner" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,6"
                                   Text="$250 default. $750 yellow gold text. $1,500 bold, orange border, Visibility banner." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Set $250" Click="SetAmount250_OnClick" Margin="0,0,8,0" Padding="10,4" />
                            <Button Content="Set $750" Click="SetAmount750_OnClick" Margin="0,0,8,0" Padding="10,4" />
                            <Button Content="Set $1,500" Click="SetAmount1500_OnClick" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="Name required / rush" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                            <Button Content="Clear name (on)" Click="ClearName_OnClick" Margin="0,0,8,0" Padding="10,4" />
                            <Button Content="Restore name (off)" Click="RestoreName_OnClick" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="Notes keyword + Status" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,6"
                                   Text="Stamp URGENT for a crimson border. Set Status to Approved to freeze notes (IsReadOnly)." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Content="Stamp URGENT" Click="StampUrgent_OnClick" Margin="0,0,8,0" Padding="10,4" />
                            <Button Content="Reset notes" Click="ResetNotes_OnClick" Padding="10,4" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="4. Default  /  5. Exempt">
                    <TextBlock Style="{StaticResource Hint}" Margin="0"
                               Text="Unmatched DPs fall through to defaults (enabled, full opacity, window background). Reference is [StateChangeExempt] so temp/global/property never change it." />
                </GroupBox>

                <TextBlock Text="Winning level" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Field" />
                    <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="Winner" />
                    <TextBlock Grid.Row="0" Grid.Column="4" FontWeight="SemiBold" Text="Look" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding NameWinner}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding NameChrome}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Amount" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AmountWinner}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding AmountChrome}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding StatusWinner}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding StatusChrome}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding NotesWinner}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding NotesChrome}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Reference" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding ReferenceWinner}" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="5" Grid.Column="4" Text="{Binding ReferenceTooltip}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
